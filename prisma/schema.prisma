generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"

}


model Product {
  id          String   @id @default(uuid())
  name        String
  company     String
  description String
  image       String
  price       Int
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}